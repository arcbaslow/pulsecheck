{
  "manifest_version": 3,
  "name": "Pulsecheck - tracking audit recorder",
  "version": "0.1.0",
  "description": "Records a page's tracking requests, dataLayer and consent state, then exports the session as one .md you hand to an LLM for an audit.",
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pulsecheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
