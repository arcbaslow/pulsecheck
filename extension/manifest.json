{
  "manifest_version": 3,
  "name": "Pulsecheck - tracking audit recorder",
  "version": "0.1.1",
  "version_name": "0.1.1 alpha",
  "description": "Records tracking requests, dataLayer pushes and consent changes, then exports the session as Markdown or JSONL.",
  "homepage_url": "https://github.com/arcbaslow/pulsecheck",
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pulsecheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
